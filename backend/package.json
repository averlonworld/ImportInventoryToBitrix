    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^3.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "uuid": "^14.0.2",
